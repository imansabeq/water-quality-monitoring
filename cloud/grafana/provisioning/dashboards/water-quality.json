{
  "title": "Water Quality Monitoring (IoT)",
  "uid": "water-quality-iot",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Water Safety Status",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "water-influxdb" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"water_quality\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"water_quality\")\n  |> filter(fn: (r) => r[\"_field\"] == \"safe\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "UNSAFE", "color": "red", "index": 0 },
                "1": { "text": "SAFE", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Violation Reason",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "water-influxdb" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"water_quality\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"water_quality\")\n  |> filter(fn: (r) => r[\"_field\"] == \"reasons\")\n  |> last()"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/.*/", "values": false }
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "pH (Safe: 6.5 - 8.5)",
      "gridPos": { "h": 5, "w": 3, "x": 12, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "water-influxdb" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"water_quality\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"water_quality\")\n  |> filter(fn: (r) => r[\"_field\"] == \"ph\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 14,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 6.5 },
              { "color": "red", "value": 8.51 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Chlorine mg/L (0.2 - 2.0)",
      "gridPos": { "h": 5, "w": 3, "x": 15, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "water-influxdb" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"water_quality\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"water_quality\")\n  |> filter(fn: (r) => r[\"_field\"] == \"chlorine\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.2 },
              { "color": "red", "value": 2.01 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Turbidity NTU (<= 50)",
      "gridPos": { "h": 5, "w": 3, "x": 18, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "water-influxdb" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"water_quality\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"water_quality\")\n  |> filter(fn: (r) => r[\"_field\"] == \"turbidity\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 300,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 50.01 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "gauge",
      "title": "TDS ppm (<= 500)",
      "gridPos": { "h": 5, "w": 3, "x": 21, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "water-influxdb" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"water_quality\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"water_quality\")\n  |> filter(fn: (r) => r[\"_field\"] == \"tds\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1000,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 500.01 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "pH & Chlorine Over Time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "influxdb", "uid": "water-influxdb" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"water_quality\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"water_quality\")\n  |> filter(fn: (r) => r[\"_field\"] == \"ph\" or r[\"_field\"] == \"chlorine\")"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Turbidity & TDS Over Time",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "influxdb", "uid": "water-influxdb" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"water_quality\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"water_quality\")\n  |> filter(fn: (r) => r[\"_field\"] == \"turbidity\" or r[\"_field\"] == \"tds\")"
        }
      ]
    }
  ]
}